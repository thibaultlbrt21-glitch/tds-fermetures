# TDS Fermetures — réglages du serveur (Hostinger)
# Chaque bloc ne s'applique que si le module correspondant est présent :
# un module absent ne casse pas le site.

# Page d'erreur
ErrorDocument 404 /404.html

# Dossiers et fichiers techniques jamais servis
RedirectMatch 404 /\.git
RedirectMatch 404 /\.github
RedirectMatch 404 \.md$

# En-têtes de sécurité
<IfModule mod_headers.c>
  # Le site ne peut pas être affiché dans la page d'un autre site
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Navigateur : toujours en HTTPS pendant un an (sans les sous-domaines)
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Cache : photos et icônes un mois. Pages, feuilles de style, scripts et
# contenu : le navigateur redemande toujours au serveur s'ils ont changé
# (une mise à jour du site est donc visible tout de suite).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml application/xml text/xml
</IfModule>
